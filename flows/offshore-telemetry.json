[
  {
    "id": "offshore-tab",
    "type": "tab",
    "label": "Offshore Telemetry",
    "disabled": false,
    "info": ""
  },
  {
    "id": "mqtt-broker",
    "type": "mqtt-broker",
    "name": "Local MQTT",
    "broker": "127.0.0.1",
    "port": "1883",
    "clientid": "offshore-telemetry-lab",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "mqtt-input",
    "type": "mqtt in",
    "z": "offshore-tab",
    "name": "Sensor ingress",
    "topic": "offshore/telemetry",
    "qos": "1",
    "datatype": "json",
    "broker": "mqtt-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 180,
    "y": 160,
    "wires": [
      [
        "normalize"
      ]
    ]
  },
  {
    "id": "normalize",
    "type": "function",
    "z": "offshore-tab",
    "name": "Normalize and alarm",
    "func": "return global.get('telemetry').process(msg);",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 160,
    "wires": [
      [
        "normalized-debug",
        "archive-persist"
      ],
      [
        "alarm-output"
      ]
    ]
  },
  {
    "id": "normalized-debug",
    "type": "debug",
    "z": "offshore-tab",
    "name": "Normalized signal",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 690,
    "y": 120,
    "wires": []
  },
  {
    "id": "alarm-output",
    "type": "debug",
    "z": "offshore-tab",
    "name": "High limit alarm",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 690,
    "y": 200,
    "wires": []
  },
  {
    "id": "archive-persist",
    "type": "function",
    "z": "offshore-tab",
    "name": "Persist and synchronize",
    "func": "const archive = global.get('archive');\ntry { archive.enqueue(msg.payload); } catch (error) { node.error(error, msg); done(); return; }\narchive.drain().then(() => done()).catch(error => { node.warn(error.message); done(); });\nreturn;",
    "outputs": 0,
    "x": 650,
    "y": 240,
    "wires": []
  }
]
